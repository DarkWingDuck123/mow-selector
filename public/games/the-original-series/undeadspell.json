        {
          "height": 55,
          "title": {
            "value": "EFFECT",
            "scale": 1.0
          },
          "note": {
            "value": "<div style=\"font-size:20px;padding:4px 8px\"><b>Cast On:</b> Any enemy ship<br><br>The Spirit Wraith carries away 1 crew from an enemy ship.</div>",
            "scale": 1.0
          }
        }
